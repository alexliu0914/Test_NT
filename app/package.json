{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "collab": "PORT=3001 node --env-file-if-exists=.env collab/server.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs up",
    "db:rollback-check": "node scripts/migrate.mjs check",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "test:selftest": "node test/runner-selftest.mjs",
    "test:m1": "node test/run.js"
  },
  "dependencies": {
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/server-util": "0.56.0",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "jsdom": "30.1.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
